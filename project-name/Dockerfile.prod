# Production multi-stage Dockerfile for backend
FROM node:24-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
# install all dependencies for build
RUN npm install
COPY . ./
RUN npm run build

# Runtime image with only production dependencies and built artifacts
FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production
# install only production dependencies
COPY package.json package-lock.json ./
# install only production dependencies (use npm install to avoid lockfile mismatch in this environment)
RUN npm install --production --silent
# copy built files
COPY --from=builder /app/dist ./dist
EXPOSE 3000
CMD ["node", "dist/main"]
