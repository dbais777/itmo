# Multi-stage build: build the app, then serve with nginx
FROM node:24-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --silent
COPY . .
RUN npm run build

# Production image: nginx serving built files
FROM nginx:alpine

# nginx image already contains an 'nginx' user, ensure files owned by that user
COPY --from=builder /app/dist /usr/share/nginx/html
# Custom nginx config for SPA fallback
COPY nginx.conf /etc/nginx/conf.d/default.conf
RUN chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/run

# run nginx as non-root (default in the image is already non-root for the nginx process)
EXPOSE 80
USER nginx
CMD ["nginx", "-g", "daemon off;"]
